# Copier en .env.local pour développer. Aucune clé n'est nécessaire pour le
# fonctionnement nominal : toutes les sources utilisées sont publiques/gratuites.
# Voir docs/DATA-SOURCES.md.

# auto  = sources réelles, repli sur fixtures si une source échoue (défaut)
# live  = sources réelles uniquement (les erreurs remontent)
# mock  = fixtures uniquement (développement hors ligne, tests)
DATA_MODE=auto

# Cache partagé optionnel (Upstash Redis REST). Sans ces variables, le cache
# reste en mémoire du process — suffisant pour une instance unique. En
# serverless, chaque instance froide repart vide et recharge la chaîne
# d'options (plusieurs Mo) : avec ces variables, la valeur est réécrite
# compressée puis relue au démarrage d'une instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth FINRA — FACULTATIF. Le dataset weeklySummary répond aujourd'hui sans
# authentification (vérifié le 2026-10-19) ; ces variables permettent de
# s'authentifier si FINRA rend l'accès obligatoire.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
